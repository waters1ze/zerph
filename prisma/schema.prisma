// This is your Prisma schema file
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Task {
  id           String    @id @default(cuid())
  title        String
  description  String?
  priority     String    @default("medium")
  status       String    @default("todo")
  dueDate      String?
  dueTime      String?
  reminderSent Boolean   @default(false)
  tags         String[]
  assignees    String[]
  isShared     Boolean   @default(false)
  projectId    String?
  goalId       String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  completedAt  DateTime?
  rawText      String?
  aiGenerated  Boolean   @default(false)
  source       String?
  subtasks     Json?
  ownerChatId  BigInt?   // Telegram chatId of the user who created this task
  remindersSentCount Int   @default(0)
}

model Goal {
  id          String   @id @default(cuid())
  title       String
  description String?
  motivation  String?
  status      String   @default("on_track")
  deadline    String?
  progress    Int      @default(0)
  color       String   @default("#2d7a4f")
  milestones  Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  ownerChatId BigInt?  // Telegram chatId of the user
}

model Note {
  id           String   @id @default(cuid())
  title        String
  content      String   @db.Text
  originalText String?  @db.Text
  type         String   @default("note")
  tags         String[]
  dueDate      String?  // Optional linked date (YYYY-MM-DD)
  dueTime      String?  // Optional linked time (HH:MM)
  projectId    String?
  goalId       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  aiGenerated  Boolean  @default(false)
  pinned       Boolean  @default(false)
  ownerChatId  BigInt?  // Telegram chatId of the user
}

model TelegramChat {
  chatId                 BigInt    @id
  firstName              String?
  lastName               String?
  username               String?
  reminderIntervalMinutes Int       @default(5)
  reminderRepeatCount    Int       @default(3)
  plan                   String    @default("free") // "free" | "premium"
  subscriptionExpiry     DateTime?
  voiceCountToday        Int       @default(0)
  voiceSecondsToday      Int       @default(0)
  notesCountToday        Int       @default(0)
  chatMessagesToday      Int       @default(0)
  lastResetDate          String?   // YYYY-MM-DD
  addedAt                DateTime  @default(now())
}

model Friendship {
  id           String   @id @default(cuid())
  userChatId   BigInt
  friendChatId BigInt
  status       String   @default("accepted") // "pending" | "accepted" | "declined"
  createdAt    DateTime @default(now())

  @@unique([userChatId, friendChatId])
}
