// This is your Prisma schema file
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Task {
  id           String    @id @default(cuid())
  title        String
  description  String?
  priority     String    @default("medium")
  status       String    @default("todo")
  dueDate      String?
  dueTime      String?
  reminderSent Boolean   @default(false)
  tags         String[]
  assignees    String[]
  isShared     Boolean   @default(false)
  visibility   String    @default("private") // "private" | "public"
  linkedNoteIds String[] // IDs of linked notes shown in reminders
  projectId    String?
  goalId       String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  completedAt  DateTime?
  rawText      String?
  aiGenerated  Boolean   @default(false)
  source       String?
  subtasks     Json?
  repeat       String?   // 'yearly' | 'monthly' | 'weekly' | 'daily'
  reminderOffsetMinutes Int @default(0)
  ownerChatId  BigInt?
  authorChatId BigInt?
  completedBy  String?
  parentTaskId String?
  projectDbId  String?
  remindersSentCount Int   @default(0)
}

model Goal {
  id          String   @id @default(cuid())
  title       String
  description String?
  motivation  String?
  status      String   @default("on_track")
  deadline    String?
  progress    Int      @default(0)
  color       String   @default("#2d7a4f")
  milestones  Json?
  visibility  String   @default("private") // "private" | "public"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  ownerChatId BigInt?
}

model Note {
  id           String   @id @default(cuid())
  title        String
  content      String   @db.Text
  originalText String?  @db.Text
  type         String   @default("note")
  tags         String[]
  dueDate      String?
  dueTime      String?
  projectId    String?
  goalId       String?
  taskIds      String[]
  visibility   String   @default("private") // "private" | "public"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  aiGenerated  Boolean  @default(false)
  pinned       Boolean  @default(false)
  ownerChatId  BigInt?
}

model TelegramChat {
  chatId                 BigInt    @id
  firstName              String?
  lastName               String?
  username               String?
  birthday               String?   // YYYY-MM-DD or MM-DD
  reminderIntervalMinutes Int       @default(5)
  reminderRepeatCount    Int       @default(3)
  plan                   String    @default("free") // "free" | "premium"
  subscriptionExpiry     DateTime?
  voiceCountToday        Int       @default(0)
  voiceSecondsToday      Int       @default(0)
  notesCountToday        Int       @default(0)
  chatMessagesToday      Int       @default(0)
  lastResetDate          String?   // YYYY-MM-DD
  lastActiveAt           DateTime? @default(now())
  referredBy             BigInt?   // ChatID of referrer who invited this user
  referralCount          Int       @default(0) // Number of friends invited via referral
  isAdmin                Boolean   @default(false) // Admin privilege
  streakDays             Int       @default(0)     // Consecutive days completed tasks
  lastStreakDate         String?   // YYYY-MM-DD
  ttsEnabled             Boolean   @default(true)  // TTS Voice replies enabled
  addedAt                DateTime  @default(now())
}

model Friendship {
  id           String   @id @default(cuid())
  userChatId   BigInt
  friendChatId BigInt
  status       String   @default("accepted") // "pending" | "accepted" | "declined"
  allowTasks   Boolean  @default(false)      // Default OFF: user must explicitly enable tasks from this friend
  createdAt    DateTime @default(now())

  @@unique([userChatId, friendChatId])
}

// Full collaborative project model
model ProjectDB {
  id          String   @id @default(cuid())
  title       String
  description String?
  ownerChatId BigInt
  memberIds   BigInt[] // Array of chatIds of all members
  color       String   @default("#6366f1")
  status      String   @default("active") // "active" | "completed" | "archived"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Tracks every user ever seen in each Telegram group chat
model GroupMembership {
  id          String   @id @default(cuid())
  groupChatId BigInt
  memberChatId BigInt
  createdAt    DateTime @default(now())

  @@unique([groupChatId, memberChatId])
}

model Habit {
  id              String   @id @default(cuid())
  title           String
  icon            String?
  streak          Int      @default(0)
  lastCompletedAt String?  // YYYY-MM-DD
  frequency       String   @default("daily") // "daily" | "weekly"
  ownerChatId     BigInt?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Dynamic configuration key-value store (e.g. subscription price)
model Config {
  key       String @id
  value     String
  updatedAt DateTime @default(now()) @updatedAt
}

// Telegram Channel Automated Polls
model ChannelPoll {
  id            String   @id @default(cuid())
  pollId        String   @unique
  messageId     Int
  channelId     String   // e.g. "@zerph_off"
  question      String
  options       Json     // array of strings/objects
  date          String   // YYYY-MM-DD
  isClosed      Boolean  @default(false)
  winningOption String?
  createdAt     DateTime @default(now())
}

// Anonymized aggregate action logs for AI feature evolution & analytics
model AppActionLog {
  id        String   @id @default(cuid())
  action    String   // 'voice_task' | 'text_task' | 'complete_task' | 'clock_timer' | 'pomodoro' | 'note_created' | 'goal_created'
  chatId    BigInt?
  details   String?
  createdAt DateTime @default(now())
}

// Comments from channel posts & discussion groups analyzed by AI
model ChannelComment {
  id            String   @id @default(cuid())
  channelPostId Int?
  chatId        BigInt?
  userName      String?
  text          String
  sentiment     String?  // 'positive' | 'negative' | 'suggestion' | 'neutral'
  createdAt     DateTime @default(now())
}

