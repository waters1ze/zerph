// This is your Prisma schema file
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Task {
  id           String    @id @default(cuid())
  title        String
  description  String?
  priority     String    @default("medium")
  status       String    @default("todo")
  dueDate      String?
  dueTime      String?
  reminderSent Boolean   @default(false)
  tags         String[]
  assignees    String[]
  isShared     Boolean   @default(false)
  visibility   String    @default("private") // "private" | "public"
  linkedNoteIds String[] // IDs of linked notes shown in reminders
  projectId    String?
  goalId       String?
  habitId      String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  completedAt  DateTime?
  rawText      String?
  aiGenerated  Boolean   @default(false)
  source       String?
  subtasks     Json?
  repeat       String?   // 'yearly' | 'monthly' | 'weekly' | 'daily'
  reminderOffsetMinutes Int @default(0)
  ownerChatId  BigInt?
  authorChatId BigInt?
  completedBy  String?
  parentTaskId String?
  projectDbId  String?
  remindersSentCount Int   @default(0)

  @@index([ownerChatId])
  @@index([authorChatId])
  @@index([status])
  @@index([dueDate, reminderSent])
  @@index([createdAt])
  // PERFORMANCE (audit B6): hot-path membership checks
  // (`assignees: { has }` / `tags: { has }`) previously seq-scanned.
  @@index([assignees], type: Gin)
  @@index([tags], type: Gin)
}

model Goal {
  id          String   @id @default(cuid())
  title       String
  description String?
  motivation  String?
  status      String   @default("on_track")
  deadline    String?
  progress    Int      @default(0)
  color       String   @default("#2d7a4f")
  milestones  Json?
  visibility  String   @default("private") // "private" | "public"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  ownerChatId BigInt?

  @@index([ownerChatId])
  @@index([status])
}

model Note {
  id           String   @id @default(cuid())
  title        String
  content      String   @db.Text
  originalText String?  @db.Text
  type         String   @default("note")
  tags         String[]
  dueDate      String?
  dueTime      String?
  projectId    String?
  goalId       String?
  habitId      String?
  taskIds      String[]
  visibility   String   @default("private") // "private" | "public"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  aiGenerated  Boolean  @default(false)
  pinned       Boolean  @default(false)
  folder       String?  @default("Общее")
  ownerChatId  BigInt?

  @@index([ownerChatId])
  @@index([pinned])
  @@index([createdAt])
}

model TelegramChat {
  chatId                 BigInt    @id
  firstName              String?
  lastName               String?
  username               String?
  email                  String?   @unique
  passwordHash           String?
  authProvider           String?   // "telegram" | "vk" | "email" | "google"
  vkId                   String?
  googleEmail            String?
  birthday               String?   // YYYY-MM-DD or MM-DD
  timezone               String?   @default("Europe/Moscow") // e.g. "Europe/Moscow", "Asia/Yekaterinburg", etc.
  reminderIntervalMinutes Int       @default(5)
  reminderRepeatCount    Int       @default(0) // 0 = single notification per task (repeats are opt-in)
  plan                   String    @default("free") // "free" | "premium" | "unlimited"
  subscriptionExpiry     DateTime?
  voiceCountToday        Int       @default(0)
  voiceSecondsToday      Int       @default(0)
  notesCountToday        Int       @default(0)
  chatMessagesToday      Int       @default(0)
  lastResetDate          String?   // YYYY-MM-DD
  lastActiveAt           DateTime? @default(now())
  referredBy             BigInt?   // ChatID of referrer who invited this user
  referralCount          Int       @default(0) // Number of friends invited via referral
  referralRewarded       Boolean   @default(false) // True once referral bonus was already granted
  isAdmin                Boolean   @default(false) // Admin privilege
  streakDays             Int       @default(0)     // Consecutive days completed tasks
  lastStreakDate         String?   // YYYY-MM-DD
  streakVisible          Boolean   @default(true)  // Show my streak to friends (social layer opt-out)
  ttsEnabled             Boolean   @default(false) // TTS Voice replies disabled by default
  trialActivatedAt       DateTime? // Timestamp when 1-day trial was granted (new user)
  googleCalendarToken    String?   // JSON: { access_token, refresh_token, expiry_date }
  googleCalendarSync     Boolean   @default(false) // 2-way Google Calendar sync enabled
  addedAt                DateTime  @default(now())

  @@index([username])
  @@index([plan])
  @@index([lastActiveAt])
}

model Friendship {
  id           String   @id @default(cuid())
  userChatId   BigInt
  friendChatId BigInt
  status       String   @default("accepted") // "pending" | "accepted" | "declined"
  allowTasks   Boolean  @default(false)      // Default OFF: user must explicitly enable tasks from this friend
  createdAt    DateTime @default(now())

  @@unique([userChatId, friendChatId])
  @@index([userChatId])
  @@index([friendChatId])
  @@index([status])
}

// One-time login tokens for secure web browser auth
model LoginToken {
  id        String   @id @default(cuid())
  chatId    BigInt
  token     String   @unique
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([chatId])
  // (audit B6) removed redundant @@index([token]) — @unique already indexes it
}

// Active browser sessions — one per device/browser login
model UserSession {
  id           String   @id @default(cuid())
  chatId       BigInt
  sessionToken String   @unique          // same token stored in localStorage
  deviceName   String?                   // parsed from User-Agent: "Chrome on Windows"
  deviceType   String   @default("web")  // "web" | "telegram" | "mobile"
  ipAddress    String?
  userAgent    String?
  lastSeenAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  isRevoked    Boolean  @default(false)

  @@index([chatId])
  // (audit B6) removed redundant @@index([sessionToken]) — @unique already indexes it
}

// Full collaborative project model
model ProjectDB {
  id          String   @id @default(cuid())
  title       String
  description String?
  ownerChatId BigInt
  memberIds   BigInt[] // Array of chatIds of all members
  color       String   @default("#6366f1")
  status      String   @default("active") // "active" | "completed" | "archived"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ownerChatId])
  @@index([status])
}

// Tracks every user ever seen in each Telegram group chat
model GroupMembership {
  id          String   @id @default(cuid())
  groupChatId BigInt
  memberChatId BigInt
  createdAt    DateTime @default(now())

  @@unique([groupChatId, memberChatId])
}

model Habit {
  id              String   @id @default(cuid())
  title           String
  icon            String?
  streak          Int      @default(0)
  lastCompletedAt String?  // YYYY-MM-DD
  frequency       String   @default("daily") // "daily" | "weekly"
  ownerChatId     BigInt?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([ownerChatId])
}

// Dynamic configuration key-value store (e.g. subscription price)
model Config {
  key       String @id
  value     String
  updatedAt DateTime @default(now()) @updatedAt
}

// Telegram Channel Automated Polls
model ChannelPoll {
  id            String   @id @default(cuid())
  pollId        String   @unique
  messageId     Int
  channelId     String   // e.g. "@zerph_off"
  question      String
  options       Json     // array of strings/objects
  date          String   // YYYY-MM-DD
  isClosed      Boolean  @default(false)
  winningOption String?
  createdAt     DateTime @default(now())
}

// Anonymized aggregate action logs for AI feature evolution & analytics
model AppActionLog {
  id        String   @id @default(cuid())
  action    String   // 'voice_task' | 'text_task' | 'complete_task' | 'clock_timer' | 'pomodoro' | 'note_created' | 'goal_created' | 'digest_tokens'
  chatId    BigInt?
  details   String?
  createdAt DateTime @default(now())

  @@index([chatId])
  @@index([createdAt])
}

// ── Hierarchical task memory (day -> week -> month -> year digests) ─────────

/// Additive summary layer over raw activity. Raw data is NEVER mutated or
/// deleted by the memory system. Level N is built ONLY from level N-1 rows;
/// only "day" reads raw tables. Idempotent via unique key.
model TimeDigest {
  id          String   @id @default(cuid())
  ownerChatId BigInt
  level       String   // "day" | "week" | "month" | "year"
  periodStart DateTime
  periodEnd   DateTime
  content     Json     // structured: {made[],moved[],missed[],habits{},patterns[],topTags[],oneLiner,stats{}}
  text        String   // human markdown (<= ~400 tokens)
  model       String   // Groq model used ("empty-marker" when skipped)
  inputTokens Int      @default(0)
  createdAt   DateTime @default(now())

  @@unique([ownerChatId, level, periodStart])
  @@index([ownerChatId, level])
}

/// Long-lived user traits distilled from month digests (<=800 tok core),
/// refreshed bi-weekly trends (<=300 tok). Consumed by every AI feature
/// through buildMemoryContext() ONLY.
model UserPortrait {
  ownerChatId BigInt  @id
  core        Json    // stable traits: chronotype, style, pace, frequent failure modes
  recent      Json    // last ~2 weeks trends
  version     Int     @default(0)
  updatedAt   DateTime @updatedAt
}

// Comments from channel posts & discussion groups analyzed by AI
model ChannelComment {
  id            String    @id @default(cuid())
  channelPostId Int?
  chatId        BigInt?
  userName      String?
  text          String
  sentiment     String?   // 'positive' | 'negative' | 'suggestion' | 'neutral'
  isAnalyzed    Boolean   @default(false)
  analyzedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@index([isAnalyzed])
}

// Promo codes system for discounts and free subscriptions
model PromoCode {
  id              String    @id @default(cuid())
  code            String    @unique
  discountPercent Int       @default(100) // 100% = free, 30% = 30% off, etc.
  targetPlan      String    @default("all") // "all" | "premium" | "unlimited"
  durationDays    Int       @default(30) // duration granted if activated (e.g. 30, 90, 365 days)
  maxActivations  Int       @default(1) // maximum allowed activations
  usedCount       Int       @default(0) // total activations count
  usedByChatIds   String[]  // array of stringified chatIds
  expiresAt       DateTime?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
}

// Corporate team workspaces with shared billing
model Team {
  id                 String    @id @default(cuid())
  name               String
  ownerChatId        BigInt
  // DEPRECATED (audit B7): legacy denormalized membership arrays. Kept during
  // the expand-contract transition — authoritative source is TeamMember.
  memberIds          BigInt[]
  adminIds           BigInt[]
  plan               String    @default("corp")
  subscriptionExpiry DateTime?
  inviteCode         String    @unique @default(cuid()) // Join link token
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([ownerChatId])
}

// RELATIONAL MEMBERSHIP (audit B7): replaces Team.memberIds/adminIds arrays.
model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  chatId    BigInt
  role      String   @default("member") // owner | admin | member
  createdAt DateTime @default(now())

  @@unique([teamId, chatId])
  @@index([chatId])
}

// RELATIONAL MEMBERSHIP (audit B7): replaces ProjectDB.memberIds array.
model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  chatId    BigInt
  role      String   @default("member") // owner | member
  createdAt DateTime @default(now())

  @@unique([projectId, chatId])
  @@index([chatId])
}
