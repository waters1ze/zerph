// This is your Prisma schema file
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Task {
  id           String    @id @default(cuid())
  title        String
  description  String?
  priority     String    @default("medium")
  status       String    @default("todo")
  dueDate      String?
  dueTime      String?
  reminderSent Boolean   @default(false)
  tags         String[]
  assignees    String[]
  isShared     Boolean   @default(false)
  projectId    String?
  goalId       String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  completedAt  DateTime?
  rawText      String?
  aiGenerated  Boolean   @default(false)
  source       String?
  subtasks     Json?
  repeat       String?   // 'yearly' | 'monthly' | 'weekly' | 'daily'
  reminderOffsetMinutes Int @default(0) // minutes before event to send reminder (e.g. 5, 15, 60)
  ownerChatId  BigInt?   // Telegram chatId of the user who created this task
  authorChatId BigInt?   // Telegram chatId of person who assigned this task (may differ from owner)
  completedBy  String?   // Name/ChatId of person who completed this task
  parentTaskId String?   // For subtask tree (references another Task.id)
  projectDbId  String?   // References ProjectDB.id
  remindersSentCount Int   @default(0)
}

model Goal {
  id          String   @id @default(cuid())
  title       String
  description String?
  motivation  String?
  status      String   @default("on_track")
  deadline    String?
  progress    Int      @default(0)
  color       String   @default("#2d7a4f")
  milestones  Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  ownerChatId BigInt?  // Telegram chatId of the user
}

model Note {
  id           String   @id @default(cuid())
  title        String
  content      String   @db.Text
  originalText String?  @db.Text
  type         String   @default("note")
  tags         String[]
  dueDate      String?  // Optional linked date (YYYY-MM-DD)
  dueTime      String?  // Optional linked time (HH:MM)
  projectId    String?
  goalId       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  aiGenerated  Boolean  @default(false)
  pinned       Boolean  @default(false)
  ownerChatId  BigInt?  // Telegram chatId of the user
}

model TelegramChat {
  chatId                 BigInt    @id
  firstName              String?
  lastName               String?
  username               String?
  birthday               String?   // YYYY-MM-DD or MM-DD
  reminderIntervalMinutes Int       @default(5)
  reminderRepeatCount    Int       @default(3)
  plan                   String    @default("free") // "free" | "premium"
  subscriptionExpiry     DateTime?
  voiceCountToday        Int       @default(0)
  voiceSecondsToday      Int       @default(0)
  notesCountToday        Int       @default(0)
  chatMessagesToday      Int       @default(0)
  lastResetDate          String?   // YYYY-MM-DD
  lastActiveAt           DateTime? @default(now())
  referredBy             BigInt?   // ChatID of referrer who invited this user
  referralCount          Int       @default(0) // Number of friends invited via referral
  addedAt                DateTime  @default(now())
}

model Friendship {
  id           String   @id @default(cuid())
  userChatId   BigInt
  friendChatId BigInt
  status       String   @default("accepted") // "pending" | "accepted" | "declined"
  allowTasks   Boolean  @default(false)      // Default OFF: user must explicitly enable tasks from this friend
  createdAt    DateTime @default(now())

  @@unique([userChatId, friendChatId])
}

// Full collaborative project model
model ProjectDB {
  id          String   @id @default(cuid())
  title       String
  description String?
  ownerChatId BigInt
  memberIds   BigInt[] // Array of chatIds of all members
  color       String   @default("#6366f1")
  status      String   @default("active") // "active" | "completed" | "archived"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Tracks every user ever seen in each Telegram group chat
model GroupMembership {
  id          String   @id @default(cuid())
  groupChatId BigInt
  memberChatId BigInt
  createdAt   DateTime @default(now())

  @@unique([groupChatId, memberChatId])
}
