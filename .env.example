# Zerf — Environment Variables
# Copy this file to .env.local and fill in your values

# ── AI ───────────────────────────────────────────────────────────────────────
# Get for free at https://console.groq.com
GROQ_API_KEY=gsk_your_key_here

# ── Telegram Bot ─────────────────────────────────────────────────────────────
# Get from @BotFather on Telegram → /newbot
TELEGRAM_BOT_TOKEN=your_bot_token_here

# ── App URL ──────────────────────────────────────────────────────────────────
# For local dev — leave as is
# For production — set to your public URL (e.g. https://myapp.railway.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Telegram Mini App URL (usually NEXT_PUBLIC_APP_URL + /tg)
TG_MINIAPP_URL=http://localhost:3000/tg

# ── Security secrets (REQUIRED in production — generate with: openssl rand -hex 32) ──
# Admin/server-to-server secret (cron, bot internal calls, /api/setup)
ADMIN_SECRET=
# Pepper for internal HMAC derivations
AUTH_PEPPER=
# Vercel Cron secret (Vercel sends it as Authorization: Bearer automatically)
CRON_SECRET=
# Telegram webhook secret_token (echoed by Telegram in X-Telegram-Bot-Api-Secret-Token)
TELEGRAM_WEBHOOK_SECRET=
# YooMoney webhook notification secret (Настройки ЮMoney → Уведомления)
YOOMONEY_NOTIFICATION_SECRET=
# Предыдущий секрет — временно принимается при ротации секрета (потом удалите)
YOOMONEY_NOTIFICATION_SECRET_OLD=
# VK Mini App protected key (редактор приложения ВК) — включает вход через VK Mini App
VK_APP_SECRET=
