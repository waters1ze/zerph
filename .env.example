# Zerf — Environment Variables
# Copy this file to .env.local and fill in your values

# ── AI ───────────────────────────────────────────────────────────────────────
# Get for free at https://console.groq.com
GROQ_API_KEY=gsk_your_key_here

# ── Telegram Bot ─────────────────────────────────────────────────────────────
# Get from @BotFather on Telegram → /newbot
TELEGRAM_BOT_TOKEN=your_bot_token_here

# ── App URL ──────────────────────────────────────────────────────────────────
# For local dev — leave as is
# For production — set to your public URL (e.g. https://myapp.railway.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Telegram Mini App URL (usually NEXT_PUBLIC_APP_URL + /tg)
TG_MINIAPP_URL=http://localhost:3000/tg
